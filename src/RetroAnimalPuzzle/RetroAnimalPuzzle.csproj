<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SkiaSharp.Views.WindowsForms 4.x ships its modern build only for this Windows SDK version. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>RetroAnimalPuzzle</RootNamespace>
    <!-- The bamboo tile, generated by running the game with the icon switch (see README, Developer tools). -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetroAnimalPuzzle.Core\RetroAnimalPuzzle.Core.csproj" />
  </ItemGroup>

  <!-- Optional, git-ignored custom assets: LocalAssets/<path> at the repo root is copied to Assets/<path> next to the
       executable (e.g. LocalAssets/Audio/music_game.mp3). See README, Optional custom assets. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\LocalAssets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.2.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.2.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.153.1" />
  </ItemGroup>

</Project>
